# Chaîne de connexion à la base Postgres Vercel (Neon). Vercel injecte DATABASE_URL / POSTGRES_URL automatiquement.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Clé(s) secrète(s) fournie(s) par OneStock pour vérifier extension_signature (séparées par des virgules).
EXTENSION_SECRETS=

# Clé de chiffrement des settings sensibles (onestock_token…) : AES-256-GCM.
# Générer avec : openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Clé(s) d'accès à l'API /api/settings (séparées par des virgules). Vide = API désactivée.
# Générer avec : openssl rand -hex 32
SETTINGS_API_KEYS=

# Optionnel : protège toutes les pages par une authentification basique (utilisateur : admin).
ADMIN_PASSWORD=
