# Chaîne de connexion à la base Postgres Vercel (Neon). Vercel injecte DATABASE_URL / POSTGRES_URL automatiquement.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Lien vers la table "settings" dans l'explorateur de données Vercel (Storage > base > Tables > settings).
VERCEL_SETTINGS_URL=https://vercel.com/<team>/~/stores/<store-id>/data

# Optionnel : protège toutes les pages par une authentification basique (utilisateur : admin).
ADMIN_PASSWORD=
