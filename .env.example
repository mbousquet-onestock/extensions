# Chaîne de connexion à la base Postgres Vercel (Neon). Vercel injecte DATABASE_URL / POSTGRES_URL automatiquement.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Clé(s) secrète(s) fournie(s) par OneStock pour vérifier extension_signature (séparées par des virgules).
EXTENSION_SECRETS=

# Tables existantes contenant les settings (valeurs par défaut ci-dessous).
SETTINGS_TABLE=settings
GENERAL_SETTINGS_TABLE=general_settings

# Optionnel : protège toutes les pages par une authentification basique (utilisateur : admin).
ADMIN_PASSWORD=
